{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "dashboardName": {
      "type": "string",
      "defaultValue": "ACS Email Delivery Overview",
      "metadata": {
        "description": "Display name for the Azure Portal Dashboard"
      }
    },
    "dashboardId": {
      "type": "string",
      "defaultValue": "[newGuid()]",
      "metadata": {
        "description": "Unique GUID for the dashboard resource"
      }
    },
    "logAnalyticsWorkspaceResourceId": {
      "type": "string",
      "metadata": {
        "description": "Full resource ID of the Log Analytics workspace."
      }
    },
    "workbookResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional: Resource ID of the ACS Email Delivery Workbook for the link tile."
      }
    }
  },
  "variables": {
    "workspaceId": "[parameters('logAnalyticsWorkspaceResourceId')]",
    "dashboardProps": {
      "lenses": [
        {
          "order": 0,
          "parts": [
            {
              "position": { "x": 0, "y": 0, "rowSpan": 1, "colSpan": 12 },
              "metadata": {
                "inputs": [],
                "type": "Extension/HubsExtension/PartType/MarkdownPart",
                "settings": {
                  "content": {
                    "settings": {
                      "content": "# ACS Email Delivery Overview\nLast **24 hours** snapshot. Open the [ACS Email Workbook](#) for full interactive analysis.",
                      "title": "",
                      "subtitle": "",
                      "markdownSource": 1
                    }
                  }
                }
              }
            },
            {
              "position": { "x": 0, "y": 1, "rowSpan": 4, "colSpan": 3 },
              "metadata": {
                "inputs": [
                  {
                    "name": "ComponentId",
                    "value": "[variables('workspaceId')]"
                  },
                  {
                    "name": "Query",
                    "value": "ACSEmailStatusUpdateOperational\n| where TimeGenerated > ago(24h)\n| where OperationName == \"DeliveryStatusUpdate\"\n| where isnotempty(RecipientId)\n| summarize arg_max(TimeGenerated, *) by CorrelationId, RecipientId\n| count"
                  },
                  {
                    "name": "TimeRange",
                    "value": "P1D"
                  },
                  {
                    "name": "Dimensions",
                    "value": {
                      "xAxis": { "name": "TimeGenerated", "type": "datetime" },
                      "yAxis": [{ "name": "Count", "type": "long" }],
                      "splitBy": [],
                      "aggregation": "Sum"
                    }
                  },
                  {
                    "name": "Version",
                    "value": "1.0"
                  },
                  {
                    "name": "PartTitle",
                    "value": "Total Emails (24h)"
                  },
                  {
                    "name": "PartSubTitle",
                    "value": "Unique recipients"
                  },
                  {
                    "name": "resourceTypeMode",
                    "value": "workspace"
                  },
                  {
                    "name": "ControlType",
                    "value": "AnalyticsDonut"
                  },
                  {
                    "name": "Visualization",
                    "value": "single"
                  },
                  {
                    "name": "DashboardId",
                    "value": "[parameters('dashboardId')]"
                  }
                ],
                "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
                "settings": {},
                "asset": {
                  "idInputName": "ComponentId",
                  "type": "LogAnalytics"
                }
              }
            },
            {
              "position": { "x": 3, "y": 1, "rowSpan": 4, "colSpan": 3 },
              "metadata": {
                "inputs": [
                  {
                    "name": "ComponentId",
                    "value": "[variables('workspaceId')]"
                  },
                  {
                    "name": "Query",
                    "value": "ACSEmailStatusUpdateOperational\n| where TimeGenerated > ago(24h)\n| where OperationName == \"DeliveryStatusUpdate\"\n| where isnotempty(RecipientId)\n| summarize arg_max(TimeGenerated, *) by CorrelationId, RecipientId\n| where DeliveryStatus == \"Delivered\"\n| count"
                  },
                  {
                    "name": "TimeRange",
                    "value": "P1D"
                  },
                  {
                    "name": "Version",
                    "value": "1.0"
                  },
                  {
                    "name": "PartTitle",
                    "value": "Delivered (24h)"
                  },
                  {
                    "name": "PartSubTitle",
                    "value": "Successfully delivered"
                  },
                  {
                    "name": "resourceTypeMode",
                    "value": "workspace"
                  },
                  {
                    "name": "ControlType",
                    "value": "AnalyticsDonut"
                  },
                  {
                    "name": "Visualization",
                    "value": "single"
                  },
                  {
                    "name": "DashboardId",
                    "value": "[parameters('dashboardId')]"
                  }
                ],
                "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
                "settings": {},
                "asset": {
                  "idInputName": "ComponentId",
                  "type": "LogAnalytics"
                }
              }
            },
            {
              "position": { "x": 6, "y": 1, "rowSpan": 4, "colSpan": 3 },
              "metadata": {
                "inputs": [
                  {
                    "name": "ComponentId",
                    "value": "[variables('workspaceId')]"
                  },
                  {
                    "name": "Query",
                    "value": "ACSEmailStatusUpdateOperational\n| where TimeGenerated > ago(24h)\n| where OperationName == \"DeliveryStatusUpdate\"\n| where isnotempty(RecipientId)\n| summarize arg_max(TimeGenerated, *) by CorrelationId, RecipientId\n| where DeliveryStatus == \"Bounced\"\n| count"
                  },
                  {
                    "name": "TimeRange",
                    "value": "P1D"
                  },
                  {
                    "name": "Version",
                    "value": "1.0"
                  },
                  {
                    "name": "PartTitle",
                    "value": "Bounced (24h)"
                  },
                  {
                    "name": "PartSubTitle",
                    "value": "Bounced emails"
                  },
                  {
                    "name": "resourceTypeMode",
                    "value": "workspace"
                  },
                  {
                    "name": "ControlType",
                    "value": "AnalyticsDonut"
                  },
                  {
                    "name": "Visualization",
                    "value": "single"
                  },
                  {
                    "name": "DashboardId",
                    "value": "[parameters('dashboardId')]"
                  }
                ],
                "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
                "settings": {},
                "asset": {
                  "idInputName": "ComponentId",
                  "type": "LogAnalytics"
                }
              }
            },
            {
              "position": { "x": 9, "y": 1, "rowSpan": 4, "colSpan": 3 },
              "metadata": {
                "inputs": [
                  {
                    "name": "ComponentId",
                    "value": "[variables('workspaceId')]"
                  },
                  {
                    "name": "Query",
                    "value": "ACSEmailStatusUpdateOperational\n| where TimeGenerated > ago(24h)\n| where OperationName == \"DeliveryStatusUpdate\"\n| where isnotempty(RecipientId)\n| summarize arg_max(TimeGenerated, *) by CorrelationId, RecipientId\n| where DeliveryStatus in (\"Failed\", \"Bounced\")\n| count"
                  },
                  {
                    "name": "TimeRange",
                    "value": "P1D"
                  },
                  {
                    "name": "Version",
                    "value": "1.0"
                  },
                  {
                    "name": "PartTitle",
                    "value": "Failed + Bounced (24h)"
                  },
                  {
                    "name": "PartSubTitle",
                    "value": "Requires attention"
                  },
                  {
                    "name": "resourceTypeMode",
                    "value": "workspace"
                  },
                  {
                    "name": "ControlType",
                    "value": "AnalyticsDonut"
                  },
                  {
                    "name": "Visualization",
                    "value": "single"
                  },
                  {
                    "name": "DashboardId",
                    "value": "[parameters('dashboardId')]"
                  }
                ],
                "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
                "settings": {},
                "asset": {
                  "idInputName": "ComponentId",
                  "type": "LogAnalytics"
                }
              }
            },
            {
              "position": { "x": 0, "y": 5, "rowSpan": 4, "colSpan": 6 },
              "metadata": {
                "inputs": [
                  {
                    "name": "ComponentId",
                    "value": "[variables('workspaceId')]"
                  },
                  {
                    "name": "Query",
                    "value": "let LatestStatus =\n    ACSEmailStatusUpdateOperational\n    | where TimeGenerated > ago(7d)\n    | where OperationName == \"DeliveryStatusUpdate\"\n    | where isnotempty(RecipientId)\n    | summarize arg_max(TimeGenerated, *) by CorrelationId, RecipientId;\nLatestStatus\n| summarize\n    Total     = count(),\n    Delivered = countif(DeliveryStatus == \"Delivered\")\n    by SenderDomain\n| extend DeliveryRatePct = round(100.0 * Delivered / Total, 1)\n| top 10 by Total desc\n| project SenderDomain, DeliveryRatePct, Total"
                  },
                  {
                    "name": "TimeRange",
                    "value": "P7D"
                  },
                  {
                    "name": "Version",
                    "value": "1.0"
                  },
                  {
                    "name": "PartTitle",
                    "value": "Delivery Rate by Domain (7d, top 10)"
                  },
                  {
                    "name": "resourceTypeMode",
                    "value": "workspace"
                  },
                  {
                    "name": "ControlType",
                    "value": "AnalyticsChart"
                  },
                  {
                    "name": "Visualization",
                    "value": "bar"
                  },
                  {
                    "name": "DashboardId",
                    "value": "[parameters('dashboardId')]"
                  }
                ],
                "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
                "settings": {},
                "asset": {
                  "idInputName": "ComponentId",
                  "type": "LogAnalytics"
                }
              }
            },
            {
              "position": { "x": 6, "y": 5, "rowSpan": 4, "colSpan": 6 },
              "metadata": {
                "inputs": [
                  {
                    "name": "ComponentId",
                    "value": "[variables('workspaceId')]"
                  },
                  {
                    "name": "Query",
                    "value": "ACSEmailStatusUpdateOperational\n| where TimeGenerated > ago(7d)\n| where OperationName == \"DeliveryStatusUpdate\"\n| where isnotempty(RecipientId)\n| summarize Count = count() by bin(TimeGenerated, 6h), DeliveryStatus\n| order by TimeGenerated asc"
                  },
                  {
                    "name": "TimeRange",
                    "value": "P7D"
                  },
                  {
                    "name": "Version",
                    "value": "1.0"
                  },
                  {
                    "name": "PartTitle",
                    "value": "Delivery Status Trend (7d)"
                  },
                  {
                    "name": "resourceTypeMode",
                    "value": "workspace"
                  },
                  {
                    "name": "ControlType",
                    "value": "AnalyticsChart"
                  },
                  {
                    "name": "Visualization",
                    "value": "linechart"
                  },
                  {
                    "name": "DashboardId",
                    "value": "[parameters('dashboardId')]"
                  }
                ],
                "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart",
                "settings": {},
                "asset": {
                  "idInputName": "ComponentId",
                  "type": "LogAnalytics"
                }
              }
            }
          ]
        }
      ],
      "metadata": {
        "model": {}
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Portal/dashboards",
      "apiVersion": "2020-09-01-preview",
      "name": "[parameters('dashboardId')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "hidden-title": "[parameters('dashboardName')]"
      },
      "properties": "[variables('dashboardProps')]"
    }
  ],
  "outputs": {
    "dashboardResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Portal/dashboards', parameters('dashboardId'))]"
    }
  }
}
